# =======================================================
# REACHINBOX SMART EMAIL SCHEDULER - ENVIRONMENT CONFIG
# =======================================================

# App Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database (Prisma)
# Default Docker connection: postgresql://postgres:postgrespassword@localhost:5432/reachinbox?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/reachinbox?schema=public"

# Redis Queue Configuration (BullMQ Persistent Delayed Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-reachinbox-2025-change-me-in-production
JWT_EXPIRES_IN=7d

# Ethereal Email SMTP Credentials
# Leave blank to automatically generate ephemeral test credentials upon startup
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ReachInbox Scheduler <scheduler@reachinbox.test>"
ETHEREAL_AUTO_CREATE=true

