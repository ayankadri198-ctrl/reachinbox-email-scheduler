generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  emails       Email[]

  @@map("users")
}

model Email {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient    String
  subject      String
  body         String
  scheduledAt  DateTime
  sentAt       DateTime?
  status       EmailStatus @default(SCHEDULED)
  bullJobId    String?     @unique
  attempts     Int         @default(0)
  errorMessage String?
  previewUrl   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, status])
  @@index([scheduledAt])
  @@index([status])
  @@index([createdAt])
  @@map("emails")
}

