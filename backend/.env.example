# =======================================================
# REACHINBOX BACKEND - ENVIRONMENT CONFIGURATION
# =======================================================

NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database (Prisma)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/reachinbox?schema=public"

# Redis Configuration (BullMQ Persistent Delayed Queue)
# Set REDIS_URL for Render / Upstash / Cloud Redis or specify host/port
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=reachinbox-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# SMTP Email Configuration (Nodemailer / Ethereal)
# Leave blank to automatically generate ephemeral test credentials upon startup
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ReachInbox Scheduler <scheduler@reachinbox.test>"
ETHEREAL_AUTO_CREATE=true

